# The package this repository is. COPYRIGHT_HEADER.md in this repository maps
# every repository to its own identifier.
IDENTIFIER='Valkyrja GitHub'

# The files that carry no copyright header. Every other tracked file must carry
# it, so a new file fails the check until a person adds the header or adds the
# file here.
EXCLUDED=(
    # A document, a workflow, and a configuration file hold no program code.
    '*.md'
    '*.json'
    '*.yml'
    '*.gitattributes'
    '*.editorconfig'
    '*.gitignore'
)
