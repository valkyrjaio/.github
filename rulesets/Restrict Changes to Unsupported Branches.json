{
  "id": 15171520,
  "name": "Restrict Changes to Unsupported Branches",
  "target": "branch",
  "source_type": "Repository",
  "source": "valkyrjaio/roadrunner",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/??.x-backup",
        "refs/heads/master-backup"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "creation"
    },
    {
      "type": "update"
    }
  ],
  "bypass_actors": []
}